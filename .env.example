# Required: your OpenAI API key. Used server-side only (app/api/generate-review/route.ts).
# Never commit your real key - this file is a template only.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for review generation.
# Defaults to gpt-4o-mini if not set.
OPENAI_MODEL=gpt-4o-mini

# Optional: set to "true" to enable the anonymous analytics hook in lib/analytics.ts.
# Leave unset/false to keep analytics fully disabled.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
